# 模型名称。
LLM_MODEL_ID=your-model-name

# 模型服务 API Key。
LLM_API_KEY=your-api-key

# OpenAI 兼容接口地址。
LLM_BASE_URL=https://your-api-base-url/v1

# LLM 请求超时时间，单位秒。
LLM_TIMEOUT=120

# Android 原项目根目录。
ANDROID_PROJECT_DIR='C:\path\to\android-project'

# DevEco/Harmony 空壳模板工程目录。
HARMONY_TEMPLATE_DIR='./HarmonyTemplate/template'

# Harmony 生成产物根目录。
HARMONY_SOURCE_PROJECT_DIR='./HarmonyProject'

# 完整 DevEco 工程的输出目录基准名；main.py 会追加时间戳。
HARMONY_WORK_BASE_DIR='./HarmonyCheckWorkDir'

# DevEco Studio 自带 Node.js 目录，构建时需要。
NODE_HOME='C:\Program Files\Huawei\DevEco Studio\tools\node'

# ===== 差分测试门禁（--enable-diff-gate 时生效）=====

# hdc 工具路径（在 PATH 中可留空或写 hdc）。
HDC_PATH=hdc

# 鸿蒙设备/模拟器序列号（hdc list targets；单设备可留空）。
HARMONY_DEVICE=

# 门禁工作目录：种子轨迹（seeds/）、契约文件、分叉报告与历史。
# 留空则默认使用 <打包工程>/.diff_gate。
DIFF_GATE_WORKSPACE='./.diff_gate'

# 种子轨迹目录（Trace JSON，安卓端录制产物）。
# 留空则默认使用 <门禁工作目录>/seeds。
DIFF_GATE_SEEDS_DIR=
